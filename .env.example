# ============================================================
#  ШАБЛОН настроек. Скопируй в .env и заполни своими значениями:
#      cp .env.example .env      (Windows: copy .env.example .env)
#
#  ВАЖНО: этот файл КОММИТИТСЯ в git, а .env — нет (см. .gitignore).
#  Никогда не вписывай реальные ключи сюда: они уедут в репозиторий.
# ============================================================

# --- Telegram -------------------------------------------------
# Токен бота, который выдаёт @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Твой личный Telegram ID (узнать: напиши @userinfobot).
# Только этот пользователь сможет общаться с ботом.
OWNER_TELEGRAM_ID=123456789

# --- LLM (чат) -------------------------------------------------
# Ключ провайдера. Ниже настроен OpenRouter (openrouter.ai -> Keys).
OPENAI_API_KEY=sk-or-v1-example-replace-me

# Базовая точка API. Пусто = официальный OpenAI.
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq (быстрый, есть бесплатный лимит): https://api.groq.com/openai/v1
#   DeepSeek напрямую: https://api.deepseek.com/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Модель. Точный slug смотри на openrouter.ai/models (кнопка «Copy model slug»).
OPENAI_MODEL=deepseek/deepseek-v4.1-flash

# --- STT (распознавание голосовых) -----------------------------
# ВАЖНО: OpenRouter не умеет /audio/transcriptions, поэтому голосовые
# расшифровываются отдельным провайдером. Самый удобный бесплатный — Groq.
#   1. Зарегистрируйся на console.groq.com -> API Keys -> Create key (gsk_...)
#   2. Вставь его в STT_API_KEY. STT_BASE_URL можно не заполнять —
#      по умолчанию подставится Groq.
# Если STT_API_KEY не задан, голосовые будут работать только на официальном OpenAI.
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=whisper-large-v3-turbo
# Язык подсказкой (ru, kk, en). Пусто = автоопределение — обычно так лучше.
STT_LANGUAGE=

# --- Приложение ----------------------------------------------
# Часовой пояс пользователя (все даты вводятся и показываются в нём)
TZ=Asia/Almaty

# Путь к файлу базы данных SQLite
DB_PATH=./data/assistant.db

# За сколько минут до срока напоминать (по умолчанию: неделя, сутки, час)
DEFAULT_REMIND_OFFSETS=10080,1440,60

# Утренний дайджест, локальное время (HH:MM). Пусто = выключить.
DAILY_DIGEST_TIME=07:00

# Еженедельный обзор: день недели (mon..sun) и время. Пустой день = выключить.
WEEKLY_REVIEW_DAY=sun
WEEKLY_REVIEW_TIME=23:00

# HTTP-порт для health-check (нужен только на облачных хостингах вроде Render).
# Пусто = мини-сервер не поднимается.
HEALTH_PORT=
