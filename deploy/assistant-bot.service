[Unit]
Description=Personal AI assistant Telegram bot
Documentation=https://github.com/xtrysaa/personal-assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
# Путь именно /opt, а не домашняя папка: при SELinux в режиме Enforcing
# systemd не может исполнить бинарник из /home (метка user_home_t) и сервис
# падает с `status=203/EXEC Permission denied`.
WorkingDirectory=/opt/assistant
ExecStart=/opt/assistant/.venv/bin/python run.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Небольшая страховка: боту хватает ~80 МБ, больше ему не нужно
MemoryMax=400M

# На машине всего 498 МБ, и ядро при нехватке памяти убивает самый крупный
# процесс. Бот крупным не бывает, но подстрахуемся: при global OOM ядро
# выберет другую жертву (раньше ею становился dnf — см. README, раздел 4.5).
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
